TZ=Asia/Seoul
# 로컬 compose 기본값. 배포는 GitHub Secrets의 POSTGRES_PASSWORD를 씁니다.
POSTGRES_USER=nuri
POSTGRES_PASSWORD=nuri
POSTGRES_DB=nuri
# compose 안에서는 postgres/redis 호스트명. 호스트에서 API를 띄울 때는 localhost.
DATABASE_URL=postgres://nuri:nuri@localhost:15432/nuri
REDIS_URL=redis://localhost:16379
# 호스트 nginx 뒤에서 Vite HMR을 붙일 때만 필요해요.
VITE_PUBLIC_HOST=nuri.mulumpyo.com
# 로컬은 32자 이상. 배포 JWT_SECRET은 GitHub Secrets에서 새로 만드세요 (erd-studio와 공유 금지).
JWT_SECRET=change-me-in-production-use-32plus
RESEND_API_KEY=
# SMTP가 없을 때만 씁니다. 배포는 GitHub Secret RESEND_API_KEY를 서버 .env에 넣습니다.
# 배포에서만 씁니다. 호스트 8082는 erd-studio라 8083만 127.0.0.1에 엽니다.
NURI_HTTP_PORT=8083
# 카카오 SMTP. 배포에서 메일이 없으면 초대가 실패해요.
SMTP_HOST=smtp.kakao.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mulumpyo
SMTP_PASS=
SMTP_FROM="누리디에스엠 <mulumpyo@kakao.com>"
BOOTSTRAP_ADMIN_EMAIL=
# 8자 이상. 있으면 그 이메일 계정을 만들고, 이미 비밀번호가 있으면 덮어쓰지 않아요.
BOOTSTRAP_ADMIN_PASSWORD=
# 공공데이터포털 특일정보 인증키. Encoding/Decoding 어느 쪽이든 됩니다. 비우면 불러오기가 실패로 표시돼요.
DATA_GO_KR_SERVICE_KEY=
# 로컬 http. 배포는 https://nuri.mulumpyo.com
PUBLIC_ORIGIN=http://localhost:5173
TOTP_ISSUER=누리디에스엠
COOKIE_SECURE=false
PORT=3000
