{
  "rootDir": ".",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": { "^.+\\.ts$": "ts-jest" },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "forceExit": true,
  "moduleNameMapper": {
    "^@nuri/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  }
}
